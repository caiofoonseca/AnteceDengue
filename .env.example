# Copie para .env e ajuste. Nunca commitar o .env.
DATABASE_URL=postgresql://antecedengue:antecedengue@localhost:5432/antecedengue
MQTT_HOST=localhost
MQTT_PORT=1883
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# docker compose (use letras e números na senha, ela entra numa URL)
POSTGRES_USER=antecedengue
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=antecedengue
SENSOR_FONTE=open-meteo
POSTGRES_HOST_PORT=5433

# airflow (perfil airflow); gere a chave com: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=troque-a-senha-do-airflow
AIRFLOW_FERNET_KEY=gere-uma-chave
AIRFLOW_SECRET_KEY=gere-um-segredo
AIRFLOW_HOST_PORT=8080

# login do dashboard (sem estes dois valores o acesso fica fechado; a senha não pode ser o texto de exemplo;
# DASHBOARD_AUTH=off desliga o login, só para demonstração). python scripts/setup_env.py gera as senhas
DASHBOARD_USER=g15
DASHBOARD_PASSWORD=troque-a-senha-do-painel
DASHBOARD_AUTH=on

# rede: API e dashboard publicam só em 127.0.0.1; use 0.0.0.0 para liberar na rede (o Mosquitto já fica em 0.0.0.0)
BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000
DASHBOARD_HOST_PORT=8501
MLFLOW_HOST_PORT=5000
MQTT_HOST_PORT=1883

