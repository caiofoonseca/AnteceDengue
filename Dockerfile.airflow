FROM apache/airflow:2.10.5-python3.11

ARG AIRFLOW_VERSION=2.10.5
ARG PYTHON_VERSION=3.11

USER airflow

RUN pip install --no-cache-dir "apache-airflow==${AIRFLOW_VERSION}" pytest \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt"

COPY requirements-pipeline.txt /tmp/requirements-pipeline.txt
RUN python -m venv /home/airflow/pipeline-venv \
    && /home/airflow/pipeline-venv/bin/pip install --no-cache-dir -r /tmp/requirements-pipeline.txt

USER root
RUN mkdir -p /opt/airflow/project/data /opt/airflow/project/models /opt/airflow/project/reports \
    && chown -R airflow:root /opt/airflow/project
USER airflow

ENV PIPELINE_PYTHON=/home/airflow/pipeline-venv/bin/python \
    PROJECT_DIR=/opt/airflow/project \
    PYTHONPATH=/opt/airflow/project
